# Copy to .env and fill in. NEVER commit .env — it carries the Fernet key and the
# PostgreSQL superuser password (threat T-02-03). Placeholders only in this file.

# --- Django ---------------------------------------------------------------
# Secret key. Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-me
# Comma-separated. Only read by config/settings/production.py; local.py uses ["*"].
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Control-plane database (identity, Client rows, permission grants) ----
# Web and Celery traffic reaches this THROUGH PgBouncer. See PG_ADMIN_* below for
# the direct path.
CONTROL_PLANE_DB_NAME=optique_control
CONTROL_PLANE_DB_USER=optique_app
CONTROL_PLANE_DB_PASSWORD=replace-me

# --- PgBouncer (transaction pooling) -------------------------------------
# Every business query goes here. Django sets CONN_MAX_AGE = 0 so PgBouncer, not
# Django, owns pooling (TENANT-08).
PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6433

# --- Direct-to-PostgreSQL (provisioning, migrate_all, pg_dump/pg_restore) -
# DDL, migrations and dumps must NOT go through PgBouncer: CREATE DATABASE cannot run
# inside a transaction block, and pg_dump needs a session it owns end to end.
# Deliberately a different port from PGBOUNCER_PORT.
PG_ADMIN_HOST=127.0.0.1
PG_ADMIN_PORT=5435
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=replace-me

# --- Tenant database creation --------------------------------------------
# PostgreSQL 18 ICU provider. ICU carries its own locale data, so this works on the
# stock postgres:18 image, which generates only en_US.utf8. Creating a database with a
# non-default locale also requires TEMPLATE template0.
TENANT_DB_LOCALE_PROVIDER=icu
TENANT_DB_ICU_LOCALE=fr-FR

# Database and role names are `<prefix><pk:06d>`, derived from the primary key and never
# from operator input. config/settings/test.py overrides both to `test_client_*` so a
# test run cannot adopt — and then drop — a development client's database.
# TENANT_DB_NAME_PREFIX=optique_c
# TENANT_DB_USER_PREFIX=optique_u

# --- Backup and restore (TENANT-09) --------------------------------------
# The PostgreSQL client binaries. Their major version must match the server's, or pg_dump
# refuses to dump it. The app image ships postgresql-client-18 and finds them on PATH;
# set these only on a host where they are not (Homebrew's libpq is keg-only).
# PG_DUMP_BIN=/opt/homebrew/opt/libpq/bin/pg_dump
# PG_RESTORE_BIN=/opt/homebrew/opt/libpq/bin/pg_restore
#
# Where dump artifacts go. A dump is a complete copy of one optician's ordonnances, so
# production storage must be EU-resident and encrypted at rest — gated on the Phase 1
# LEGAL-02 hosting-jurisdiction decision.
# BACKUP_STORAGE=plateforme.control_plane.storage.LocalFilesystemStorage
# BACKUP_LOCAL_ROOT=./backups

# --- Tenancy encryption ---------------------------------------------------
# Fernet key encrypting each Client row's db_password. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every client database unreachable. Consumed by plan 02-02.
TENANCY_FERNET_KEY=replace-me

# --- Celery / Redis -------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/1

# --- Sentry ---------------------------------------------------------------
# Leave blank to disable. send_default_pii is forced False in settings because
# ordonnances are health data under law 09-08.
SENTRY_DSN=
