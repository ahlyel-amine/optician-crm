# Dependances et artefacts de construction. Les chemins equivalents sont aussi
# listes dans le .gitignore racine, parce que les outils lances depuis la racine
# du depot ne lisent pas toujours celui-ci.
node_modules/
dist/

# Rapports de couverture vitest
coverage/

# Journaux npm
npm-debug.log*
yarn-error.log*

# Variables d'environnement Vite. `.env.example` reste suivi.
.env
.env.*
!.env.example

