{
  "name": "optique-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.test.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:format": "grep -rnE 'Intl\\.NumberFormat|toLocaleString|fr-MA' src --include=*.ts --include=*.tsx | grep -v '^src/format/' && { echo 'INTERDIT (03-UI-SPEC.md 8.1) : aucune locale ne decide du format de l_argent hors de src/format/'; exit 1; } || exit 0",
    "api:types": "openapi-typescript src/api/schema.yml -o src/api/types.gen.ts --default-non-nullable=false"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.0",
    "lucide-react": "1.46.0",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dom-accessibility-api": "0.5.16",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
