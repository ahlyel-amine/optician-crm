{
  // Projet applicatif. `npm run build` lance `tsc -b`, qui construit d'abord le
  // projet reference (tsconfig.node.json, la configuration des outils) puis
  // celui-ci.
  //
  // `web/tests/` etait volontairement hors de TOUTE verification de types au plan
  // 03-03 : les suites y importaient des modules qui n'existaient pas encore, et
  // les inclure aurait fait echouer la construction sur un etat rouge voulu.
  //
  // Le plan 03-11 a livre `src/format/` et `src/tableau/`, donc **les tests sont
  // de nouveau typecheckes** — par `tsconfig.test.json`, enchaine dans le script
  // `build`. Ils restent hors de CE projet parce qu'ils tournent sous Node et
  // que leur donner `@types/node` ici rendrait `process` et `node:fs` typables
  // depuis du code qui part dans le navigateur.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    // Declare les modules d'actifs de Vite (import "./index.css", ?url, ?raw).
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
