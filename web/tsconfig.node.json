{
  // Les fichiers de configuration tournent sous Node, pas dans le navigateur.
  // Projet reference par tsconfig.json, donc `composite: true`.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    // Projet reference, donc composite. TypeScript 5.9 refuse encore qu'un projet
    // reference desactive l'emission (TS6310), d'ou `emitDeclarationOnly` plutot
    // que `noEmit` : seules des declarations sortent, dans un dossier temporaire
    // sous node_modules, jamais suivi par git.
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/types-node"
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
